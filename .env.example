# Скопируйте в .env.local и заполните. .env.local не коммитится.

# Supabase → Project Settings → API (появятся на этапе 2)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) ключ. Ключ service_role сюда не кладём никогда.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Локально — пусто. На GitHub Pages workflow подставляет /<имя репозитория>.
NEXT_PUBLIC_BASE_PATH=
